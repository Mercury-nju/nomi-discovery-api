NOMI_DATA_DIR=.data
# Set a strong secret before binding beyond localhost. Never embed it in a public frontend.
NOMI_API_KEY=
# Comma-separated exact frontend origins; no wildcard.
NOMI_ALLOWED_ORIGINS=http://localhost:5173
# Optional OpenAI-compatible planning; otherwise conservative rules.
NOMI_LLM_API_KEY=
NOMI_LLM_MODEL=
